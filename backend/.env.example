# 复制为 .env 后按需修改。留空或删除则使用默认值。

# ---------------- 应用 ----------------
APP_NAME=城市出租车运营管理与决策支持系统
APP_VERSION=2.0.0
DEBUG=true

# ---------------- 安全 ----------------
# 生产环境务必修改为随机长字符串
SECRET_KEY=taxi-system-dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- 数据库 ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456789
DB_NAME=taxi_db
SQL_ECHO=false
# 也可以直接给出完整连接串（优先级高于上面的分项配置）
# DATABASE_URL=mysql+pymysql://root:123456789@localhost/taxi_db?charset=utf8mb4
# 没有 MySQL 时可用 SQLite 快速体验：
# DATABASE_URL=sqlite:///./taxi.db

# ---------------- 跨域 ----------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 业务参数（也可在「系统管理-参数配置」中修改） ----------------
EMPTY_RATE_WARN=0.40
UNFULFILLED_RATE_WARN=0.15
INCOME_DROP_WARN=-0.20

VEHICLE_SERVICE_RATE=1.5
DISPATCH_MIN_GAP=3
DISPATCH_DISTANCE_FACTOR=1.35
DISPATCH_COST_PER_KM=1.80
DISPATCH_MIN_NET_GAIN=5.0
DISPATCH_MAX_MOVE_PER_REGION=8
DISPATCH_MAX_MOVE_OUT=10

FORECAST_HORIZON=24
FORECAST_VALID_HOURS=168
FORECAST_FOLDS=3
FORECAST_MIN_HISTORY_DAYS=14
FORECAST_SELECT_METRIC=rmse

INSURANCE_WARN_DAYS=30
CERT_WARN_DAYS=30
MAINTENANCE_WARN_DAYS=15
LICENSE_WARN_DAYS=30
